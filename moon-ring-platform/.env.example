# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public site URL used for robots/sitemap (prefer this in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NOTE: Do NOT set NODE_ENV manually - Next.js sets it automatically based on command

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Email Service (Brevo)
# Get your API key from: https://app.brevo.com/settings/keys/api
# Free tier: 9,000 emails/month
BREVO_API_KEY=xkeysib-your-api-key-here

# Email Delivery Control (tests/CI)
# Set to 'false' in CI or local E2E to prevent real emails
MAIL_DELIVERY_ENABLED=true

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_HOTJAR_ID=xxxxxxx

# Bot Protection (Turnstile)
# Set BOT_PROTECTION_ENABLED=false locally to bypass verification
BOT_PROTECTION_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry Error Monitoring (OPTIONAL - Currently not installed)
# To enable Sentry, follow instructions in BUILD_TROUBLESHOOTING.md
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# Feature Flags
NEXT_PUBLIC_ENABLE_DEMO=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
